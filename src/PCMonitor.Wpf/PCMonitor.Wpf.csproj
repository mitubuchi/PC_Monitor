<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- ReactiveUI.WPF が windows10.0.19041 向けなので、画面側だけ合わせる（SubPi.Wpf・DeviceMap と同じ） -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>PCMonitor.Wpf</RootNamespace>
    <AssemblyName>PCMonitor</AssemblyName>
    <!-- 昇格を強制しない。通常の権限で起動し、見られる範囲だけ点検する（設計書 §9）。高 DPI の指定もここ -->
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>

  <ItemGroup>
    <!-- 24.1.0 は System.Reactive への依存をやめている。上げる前に必ず確かめること -->
    <PackageReference Include="ReactiveUI.WPF" Version="23.2.28" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\PCMonitor.Core\PCMonitor.Core.csproj" />
  </ItemGroup>

</Project>
