<Application x:Class="PCMonitor.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- StartupUri は使わない。ReactiveUI の初期化を済ませてから、App.xaml.cs で MainWindow を作る -->
    <Application.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <SolidColorBrush x:Key="LevelHigh" Color="#C62828" />
        <SolidColorBrush x:Key="LevelMedium" Color="#E65100" />
        <SolidColorBrush x:Key="LevelLow" Color="#8D6E00" />
        <SolidColorBrush x:Key="LevelInfo" Color="#757575" />
        <SolidColorBrush x:Key="Subtle" Color="#616161" />
        <SolidColorBrush x:Key="Line" Color="#D0D0D0" />
        <SolidColorBrush x:Key="Panel" Color="#F6F6F6" />

        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="MinHeight" Value="28" />
        </Style>
    </Application.Resources>
</Application>
